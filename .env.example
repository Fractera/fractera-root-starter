# Questions the node's installer must answer for this site — NOT settings.
#
# Values are intentionally empty unless a default is written. `npm run services:install`
# reads this file, and the `# kind:` line above a group of variables tells it WHO answers:
#
#   derived — the installer knows the answer itself (assigned port, neighbours' addresses)
#   secret  — the installer generates a random value once and writes it to BOTH ends
#   node    — taken from the node core's own environment: the core keeps the base settings
#             of the product (languages, theme, title), and the site inherits them. A node
#             without the value leaves the default written here.
#   foreign — a third-party key: the installer names it and says what breaks without it
#
# The generated file is `.env.local` in this folder (Next reads it by convention).
# Keys you add there yourself survive a reinstall.
#
# The list was derived from the code (every process.env the site reads), not from memory.

# ─── Where this site stands and who its neighbours are ───────────────────────

# kind: derived
# Port this site listens on. The node assigns it from the block 24680-24699.
PORT=
# Address of the node core that owns the architect pages; /<lang>/architect/* redirects there.
ARCHITECT_URL=
# The node's auth element — the only one that signs people in.
AUTH_SERVICE_URL=
# The node's data element. Its presence is what makes the site use the data door
# instead of opening a database file of its own.
REMOTE_DATA_URL=

# ─── The key to the data door ────────────────────────────────────────────────

# kind: secret
DATA_SECRET=

# ─── Base settings of the product, kept by the core ──────────────────────────

# kind: node
NEXT_PUBLIC_AUTH_URL=
NEXT_PUBLIC_APP_TITLE=Site
NEXT_PUBLIC_APP_DESCRIPTION=
NEXT_PUBLIC_SUPPORTED_LANGUAGES=en
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_DEFAULT_THEME=light
NEXT_PUBLIC_APP_SHELL_AUTH=

# ─── Third-party keys ────────────────────────────────────────────────────────

# kind: foreign
# Voice input and translations. Without it those two features answer that no key is set.
OPENAI_API_KEY=
